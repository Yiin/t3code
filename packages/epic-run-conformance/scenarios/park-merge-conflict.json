{
  "name": "park-merge-conflict",
  "description": "A merge conflict parks the branch and creates a merge-fix child. Narrowed to the legacy terminal adapter: the shared core's terminal cook loop is sequential, so this parallel scenario has no core leg; the gap is tracked by t3code-06s.41.",
  "repo": {
    "files": [],
    "detachedHead": false,
    "dirty": false,
    "siblingRepos": [],
    "mergeConflict": {
      "path": "conflict.txt",
      "baseContent": "base\n",
      "workerContent": "worker\n",
      "baseAdvanceContent": "base advanced\n"
    }
  },
  "beads": {
    "epicId": "epic",
    "epicExists": true,
    "runInProgress": false,
    "children": [
      {
        "id": "epic.1",
        "title": "Child",
        "status": "open",
        "priority": 1,
        "issueType": "task",
        "commentCount": 0
      }
    ]
  },
  "agentScript": [
    {
      "repoAction": "commit",
      "writes": [{ "path": "conflict.txt", "content": "worker\n" }],
      "report": { "_tag": "ralph-msg", "summary": "built", "why": "conflicting change" },
      "closeChild": true,
      "hangMs": 0
    }
  ],
  "expectedTranscript": [
    {
      "_tag": "parked",
      "sequence": 0,
      "epicId": "epic",
      "issueId": "epic.1",
      "iterationIndex": 0,
      "reason": "merge-conflict",
      "branch": "epic/epic.1"
    }
  ],
  "appliesTo": ["terminal"]
}
